<mxfile host="app.diagrams.net" modified="2026-08-18T11:15:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="UC_Reviewer" name="Use Case - Người Kiểm Duyệt">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- HEADER -->
        <mxCell id="hdr" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;SƠ ĐỒ USE CASE: PHÂN HỆ NGƯỜI KIỂM DUYỆT / HỘI ĐỒNG (REVIEWER)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B21A8&quot;&gt;Hệ thống Quản lý Tài liệu EduRepo | Thẩm định, Kiểm tra đạo văn &amp; Phê duyệt công bố&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#E9D5FF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1250" height="50" as="geometry" />
        </mxCell>

        <!-- SYSTEM BOUNDARY -->
        <mxCell id="boundary" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot; color=&quot;#6B21A8&quot;&gt;PHÂN HỆ THẨM ĐỊNH &amp; PHÊ DUYỆT (REVIEWER CONSOLE)&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=2;verticalAlign=top;align=center;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="110" width="960" height="800" as="geometry" />
        </mxCell>

        <!-- ACTORS -->
        <mxCell id="act_reader" value="&lt;b&gt;Người đọc&lt;/b&gt;&lt;br&gt;(Reader)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#0F172A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="180" width="60" height="100" as="geometry" />
        </mxCell>

        <mxCell id="act_reviewer" value="&lt;b&gt;Người kiểm duyệt&lt;/b&gt;&lt;br&gt;(Reviewer)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#9333EA;strokeColor=#7E22CE;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="470" width="70" height="120" as="geometry" />
        </mxCell>

        <!-- ACTOR INHERITANCE -->
        <mxCell id="e_inh" value="«kế thừa»" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=0;strokeColor=#9333EA;strokeWidth=2;" edge="1" parent="1" source="act_reviewer" target="act_reader">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- USE CASES -->
        <mxCell id="uc_1" value="Xem hàng đợi tài liệu chờ duyệt&#xa;(Pending Review Queue)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=1.5;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="150" width="260" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_2" value="Xem trước tài liệu (Preview PDF)&#xa;&amp; Kiểm tra thông tin tác giả" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=1.5;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="240" width="260" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_3" value="So sánh các phiên bản&#xa;(Version Diff &amp; Lịch sử sửa đổi)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=1.5;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="330" width="260" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_4" value="Phê duyệt tài liệu (Approve)&#xa;&amp; Chọn phạm vi công bố (PUBLIC/INTERNAL)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=1.5;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="420" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="uc_5" value="Yêu cầu chỉnh sửa (Request Edit)&#xa;&amp; Gửi ghi chú phản hồi cho tác giả" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=1.5;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="520" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="uc_6" value="Từ chối tài liệu (Reject)&#xa;&amp; Ghi rõ lý do không đạt chuẩn" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=1.5;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="620" width="260" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_7" value="Xem nhật ký thẩm định&#xa;(Audit Trail / Lịch sử các vòng duyệt)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=1.5;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="715" width="260" height="65" as="geometry" />
        </mxCell>

