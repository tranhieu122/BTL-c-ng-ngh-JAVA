<mxfile host="app.diagrams.net" modified="2026-08-18T11:20:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="UC_Admin" name="Use Case - Quản Trị Viên">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- HEADER -->
        <mxCell id="hdr" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;SƠ ĐỒ USE CASE: PHÂN HỆ QUẢN TRỊ VIÊN HỆ THỐNG (ADMIN)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;Hệ thống Quản lý Tài liệu EduRepo | Quản trị người dùng, Phân quyền RBAC &amp; Cấu hình hệ thống&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1280" height="50" as="geometry" />
        </mxCell>

        <!-- SYSTEM BOUNDARY -->
        <mxCell id="boundary" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot; color=&quot;#92400E&quot;&gt;TRUNG TÂM ĐIỀU HÀNH QUẢN TRỊ (ADMIN CONSOLE)&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;verticalAlign=top;align=center;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="110" width="990" height="850" as="geometry" />
        </mxCell>

        <!-- ACTOR -->
        <mxCell id="act_admin" value="&lt;b&gt;Quản trị viên&lt;/b&gt;&lt;br&gt;(System Admin)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#EA580C;strokeColor=#C2410C;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="450" width="70" height="120" as="geometry" />
        </mxCell>

        <!-- USE CASES -->
        <mxCell id="uc_1" value="Quản lý danh sách người dùng&#xa;(Tìm kiếm, Thêm mới, Sửa hồ sơ)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="150" width="270" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_2" value="Kích hoạt / Khóa tài khoản&#xa;(Cập nhật trạng thái ACTIVE / LOCKED)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="240" width="270" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_3" value="Phân quyền &amp; Gán vai trò (RBAC)&#xa;(Gán quyền Author, Reviewer, Admin)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="330" width="270" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_4" value="Quản lý cây danh mục (Taxonomy)&#xa;(Khoa, Bộ môn, Loại tài liệu, Chuyên ngành)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="420" width="270" height="70" as="geometry" />
        </mxCell>

        <mxCell id="uc_5" value="Quản lý từ khóa &amp; Thẻ tìm kiếm&#xa;(Keywords &amp; Tag Indexing)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="515" width="270" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_6" value="Cấu hình hệ thống &amp; Giấy phép&#xa;(Cấu hình Upload, Dung lượng, Licenses)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="605" width="270" height="70" as="geometry" />
        </mxCell>

        <mxCell id="uc_7" value="Xem Dashboard thống kê toàn trường&#xa;(Tổng tài liệu, lượt đọc, phân bổ theo khoa)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="700" width="270" height="70" as="geometry" />
        </mxCell>

        <mxCell id="uc_8" value="Xuất báo cáo tổng hợp&#xa;(Báo cáo NCKH định dạng Excel / PDF)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="795" width="270" height="65" as="geometry" />
        </mxCell>

