        <mxCell id="hdr" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;SƠ ĐỒ USE CASE: PHÂN HỆ TÁC GIẢ / GIẢNG VIÊN (AUTHOR)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#15803D&quot;&gt;Hệ thống Quản lý Tài liệu EduRepo | Nộp bài, Lưu nháp &amp; Quản lý vòng đời tài liệu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#BBF7D0;align=center;verticalAlign=middle;" vertex="1" parent="1">
