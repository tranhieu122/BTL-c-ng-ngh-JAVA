# ==============================================================================
# EduRepo Environment Template (.env.example)
# Sao chép tệp này thành .env và điền các giá trị thực tế tại môi trường local.
# TUYỆT ĐỐI KHÔNG commit tệp .env chứa secret thật lên repository.
# ==============================================================================

# OpenAI / Gemini Compatible LLM & Embedding Model Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gemini-3.5-flash
OPENAI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_TIMEOUT_SECONDS=90

# External Weather Service Configuration (Optional, fallback to Open-Meteo if blank)
WEATHER_API_KEY=
WEATHER_BASE_URL=https://api.weatherapi.com/v1
WEATHER_TIMEOUT_SECONDS=10

# Academic Sample Data Initializer (true/false)
SEED_SAMPLE_DATA=true

# RAG & Semantic Retrieval Settings
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_SIMILARITY_THRESHOLD=0.45
RAG_MAX_CONTEXT_TOKENS=3000

# Document Ingestion Pipeline Settings
RAG_MIN_PAGE_TEXT_LENGTH=40
RAG_OCR_ENABLED=true
RAG_OCR_LANGUAGE=vie+eng
RAG_TESSERACT_DATA_PATH=
RAG_CLEAN_HYPHENATION=true
RAG_PRESERVE_CODE_BLOCKS=true
