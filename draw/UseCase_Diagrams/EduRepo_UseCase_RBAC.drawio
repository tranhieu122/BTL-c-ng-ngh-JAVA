        <!-- ==================== HEADER BANNER ==================== -->
        <mxCell id="hdr_banner" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;SƠ ĐỒ USE CASE TỔNG QUAN &amp; PHÂN QUYỀN (RBAC) - HỆ THỐNG EDUREPO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 13px;&quot;&gt;Phân rã theo 5 vai trò (Guest, Reader, Author, Reviewer, Admin) &amp; Cây kế thừa quyền hạn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
